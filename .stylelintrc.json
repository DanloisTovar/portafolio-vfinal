{
  "extends": ["stylelint-config-standard", "stylelint-config-standard-scss"],
  "plugins": ["stylelint-scss"],
  "rules": {
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "variant",
          "responsive",
          "screen",
          "layer",
          "theme"
        ]
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "variant",
          "responsive",
          "screen",
          "layer",
          "theme"
        ]
      }
    ]
  }
}
