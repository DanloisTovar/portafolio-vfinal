---
import { useTranslations } from '../i18n/utils';
import LogoLoop from './Animations/LogoLoop/LogoLoop';
import {
  MessageSquare,
  Brain,
  Users,
  Zap,
  GraduationCap,
  BookOpen,
  Award,
  Database,
  Code2,
} from 'lucide-react';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import GlassCard from './ui/GlassCard.astro';
import IconBox from './ui/IconBox.astro';
import Icon from './icons/Icon.astro';
import Button from './ui/Button.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Education Data
const education = [
  {
    degree:
      lang === 'es'
        ? 'Confección y Publicación de Páginas Web'
        : 'Web Page Creation and Publication',
    institution:
      lang === 'es'
        ? 'Centro de Formación Restauradores Bercianos, Oviedo, Asturias, España'
        : 'Restauradores Bercianos Training Center, Oviedo, Asturias, Spain',
    year: '2026',
    icon: Code2,
  },
  {
    degree:
      lang === 'es' ? 'Licenciatura en Tecnologías Digitales' : 'Bachelor in Digital Technologies',
    institution: 'Universidad de la Ciudad de Buenos Aires, Argentina',
    year: '2025',
    icon: GraduationCap,
  },
  {
    degree:
      lang === 'es'
        ? 'Técnico Superior en Análisis de Sistemas'
        : 'Higher Technician in Systems Analysis',
    institution: 'IFTS N° 12, Buenos Aires, Argentina',
    year: '2023',
    icon: BookOpen,
  },
  {
    degree:
      lang === 'es' ? 'Técnico Superior en Administración' : 'Higher Technician in Administration',
    institution: 'IUDAG, Caracas, Venezuela',
    year: '2008',
    icon: Award,
  },
];

const softSkills = [
  {
    key: 'communication',
    icon: MessageSquare,
    color: 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300',
  },
  {
    key: 'problem_solving',
    icon: Brain,
    color: 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300',
  },
  {
    key: 'teamwork',
    icon: Users,
    color: 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300',
  },
  {
    key: 'adaptability',
    icon: Zap,
    color: 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-300',
  },
];
---

<Section id="skills" py="py-24" darkBg="dark:bg-gray-900/50" class="px-4" px="">
  <!-- Main Section Title -->
  <SectionHeader
    variant="gradient-accent"
    title={lang === 'es' ? 'Habilidades y Estudios' : 'Skills and Education'}
    accentText={lang === 'es' ? 'Estudios' : 'Education'}
    subtitle={lang === 'es'
      ? 'Dominio técnico y formación académica'
      : 'Technical expertise and academic background'}
    marginBottom="mb-16 lg:mb-24"
  />

  <!-- Technical Skills Title + Logo Loop -->
  <div class="mb-16">
    <SectionHeader variant="skills-subsection" title={t('skills.hard')} icon="code" />
    <LogoLoop client:visible speed={25} />
  </div>

  <!-- Education Grid (Left) + Robot (Center) Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 mb-16">
    <!-- Robot on Left (mobile: arriba) -->
    <div class="flex items-center justify-center order-1 lg:order-1">
      <div class="w-full max-w-md h-[400px] lg:h-[500px] relative overflow-hidden">
        <spline-viewer
          class="robot-habilidades block h-full w-full"
          url="https://prod.spline.design/4c8KoXXCMm-nFWlE/scene.splinecode"></spline-viewer>
      </div>
    </div>

    <!-- Education Bento Grid on Right (mobile: debajo) -->
    <div class="space-y-6 order-2 lg:order-2">
      <h3 class="text-2xl font-bold mb-6 flex items-center gap-3 text-gray-900 dark:text-white">
        <span
          class="p-3 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 text-white shadow-lg"
        >
          <GraduationCap size={24} />
        </span>
        {lang === 'es' ? 'Educación' : 'Education'}
      </h3>

      <div class="space-y-4">
        {
          education.map((edu) => (
            <GlassCard variant="glass-card-full" padding="p-6">
              <div class="flex gap-4">
                <div class="flex-shrink-0">
                  <IconBox
                    size="lg"
                    color="light"
                    class="group-hover:scale-110 transition-transform duration-500"
                  >
                    <edu.icon className="w-6 h-6 text-blue-600 dark:text-blue-400" />
                  </IconBox>
                </div>
                <div class="flex-1">
                  <h4 class="font-bold text-gray-900 dark:text-white mb-1">{edu.degree}</h4>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">{edu.institution}</p>
                  <p class="text-xs text-blue-600 dark:text-blue-400 font-medium">{edu.year}</p>
                </div>
              </div>
            </GlassCard>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Soft Skills Grid (Full Width) -->
  <div>
    <SectionHeader variant="skills-subsection" title={t('skills.soft')} icon="users" />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        softSkills.map((skill) => (
          <GlassCard variant="soft-skills">
            <div
              class={`relative z-10 w-14 h-14 rounded-2xl flex items-center justify-center mb-4 ${skill.color} group-hover:scale-110 transition-transform duration-500`}
            >
              <skill.icon size={28} />
            </div>
            <div class="relative z-10">
              <h4 class="text-lg font-bold text-gray-900 dark:text-white">
                {t(`skills.soft.${skill.key}` as any)}
              </h4>
            </div>
          </GlassCard>
        ))
      }
    </div>
  </div>

  <!-- Advanced SQL Samples -->
  <div class="mt-16">
    <SectionHeader
      variant="skills-subsection"
      title={t('skills.advancedSql.title')}
      subtitle={t('skills.advancedSql.subtitle')}
      icon="database"
      marginBottom="mb-16"
    />

    <!-- SQL Queries Grid -->
    <div class="grid grid-cols-1 gap-8 mb-12 max-w-6xl mx-auto">
      <!-- Query 1 -->
      <GlassCard
        variant="glass-card-full"
        padding="p-6"
        gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent"
      >
        <div class="flex items-center gap-3 mb-4">
          <IconBox
            size="md"
            color="light"
            class="group-hover:scale-110 transition-transform duration-500"
          >
            <Icon name="fileText" size={20} class="text-blue-600 dark:text-blue-400" />
          </IconBox>
          <h4 class="text-lg font-bold text-gray-900 dark:text-white">
            {t('skills.advancedSql.query1.title')}
          </h4>
        </div>
        <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm text-justify">
          {t('skills.advancedSql.query1.desc')}
        </p>
        <pre
          class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg text-sm overflow-x-auto"><code class="language-sql">
SELECT TOP 10
    log_id,
    country_code,
    api_endpoint,
    message_payload,
    created_at
FROM (
    SELECT
        log_id,
        country_code,
        api_endpoint,
        message_payload,
        created_at
    FROM integration_logs
    WHERE country_code = 'XX'
      AND api_endpoint = 'POST /resource'
) AS filtered_logs
WHERE message_payload LIKE CONCAT('%', :reference_id, '%')
ORDER BY created_at DESC;
</code></pre>
      </GlassCard>

      <!-- Query 2 -->
      <GlassCard
        variant="glass-card-full"
        padding="p-6"
        gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent"
      >
        <div class="flex items-center gap-3 mb-4">
          <IconBox
            size="md"
            color="light"
            class="group-hover:scale-110 transition-transform duration-500"
          >
            <Icon name="fileText" size={20} class="text-blue-600 dark:text-blue-400" />
          </IconBox>
          <h4 class="text-lg font-bold text-gray-900 dark:text-white">
            {t('skills.advancedSql.query2.title')}
          </h4>
        </div>
        <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm text-justify">
          {t('skills.advancedSql.query2.desc')}
        </p>
        <pre
          class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg text-sm overflow-x-auto"><code class="language-sql">
SELECT
    dc.dispatch_center_id      AS dispatch_center,
    pr.product_id              AS sku_code,
    0                           AS drop_size,
    cfg.is_enabled              AS is_enabled
FROM core.dispatch_centers dc
INNER JOIN core.dispatch_products pr
    ON dc.dispatch_center_id = pr.dispatch_center_id
   AND dc.company_id = pr.company_id
INNER JOIN core.warehouses wh
    ON pr.company_id = wh.company_id
   AND pr.warehouse_id = wh.warehouse_id
   AND pr.product_id = wh.product_id
INNER JOIN core.product_config cfg
    ON cfg.product_id = pr.product_id
   AND cfg.company_id = wh.company_id
   AND cfg.warehouse_id = wh.warehouse_id
WHERE cfg.product_id IN (:sku_id)
  AND dc.company_id = :company_id
  AND cfg.config_key = 'ENABLED'
  AND dc.dispatch_center_id IN (
        SELECT DISTINCT dispatch_center
        FROM analytics.vendor_dispatch_centers
  )
ORDER BY
    dispatch_center,
    sku_code;
</code></pre>
      </GlassCard>

      <!-- Query 3 -->
      <GlassCard
        variant="glass-card-full"
        padding="p-6"
        gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent"
      >
        <div class="flex items-center gap-3 mb-4">
          <IconBox
            size="md"
            color="light"
            class="group-hover:scale-110 transition-transform duration-500"
          >
            <Icon name="fileText" size={20} class="text-blue-600 dark:text-blue-400" />
          </IconBox>
          <h4 class="text-lg font-bold text-gray-900 dark:text-white">
            {t('skills.advancedSql.query3.title')}
          </h4>
        </div>
        <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm text-justify">
          {t('skills.advancedSql.query3.desc')}
        </p>
        <pre
          class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg text-sm overflow-x-auto"><code class="language-sql">
SELECT
    def.policy_value
FROM core.policy_rel rel
JOIN core.policy_def def
    ON rel.entity_type = def.entity_type
   AND rel.policy_id = def.policy_id
WHERE rel.company_id = :company_id
  AND def.valid_from &gt;= DATE ':start_date'
  AND rel.entity_type = :entity_type
  AND rel.is_active = :rel_flag
  AND def.is_active = :def_flag
GROUP BY def.policy_value,
         rel.company_id,
         rel.entity_type,
         rel.policy_id;
</code></pre>
      </GlassCard>
    </div>

    <!-- GitHub Gist Link -->
    <div class="text-center">
      <Button
        variant="gist"
        label={t('skills.advancedSql.gist_link')}
        href="https://gist.github.com/DanloisTovar/09a8ec38d8c81a7997133b4e22f7205b"
      />
    </div>
  </div>
</Section>

<style>
  /* Robot gradient mask effect */
  .robot-habilidades {
    mask-image: linear-gradient(to top, transparent 10%, black 100%);
  }
</style>

<script>
  import { initCardGlow } from '../lib/cursorGlow';

  initCardGlow();
</script>
