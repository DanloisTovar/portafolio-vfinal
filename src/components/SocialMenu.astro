<style is:global>
	/* Estilos para el menú lateral de redes sociales */
	.home-hero__socials {
		/* Asegurar centrado perfecto */
		display: flex;
		/* flex-direction se maneja con Tailwind */
		align-items: center;
		justify-content: center;
		/* Asegurar que el punto de referencia sea el centro del menú */
		transform-origin: center;
	}

	.home-hero__social-icon-link {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		border-radius: 50%;
		transition: all 0.3s ease;
		position: relative;
		border: none;
		background: transparent;
	}

	.home-hero__social-icon-link:hover {
		background: rgba(96, 165, 250, 0.2);
		transform: translateY(-2px);
		box-shadow:
			0 0 10px rgba(96, 165, 250, 0.5),
			0 0 20px rgba(96, 165, 250, 0.3),
			0 0 30px rgba(96, 165, 250, 0.1),
			inset 0 0 10px rgba(96, 165, 250, 0.1);
	}

	/* Efecto neon más intenso para el hover */
	.home-hero__social-icon-link:hover::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		border-radius: 50%;
		box-shadow:
			0 0 15px rgba(96, 165, 250, 0.8),
			0 0 30px rgba(96, 165, 250, 0.6),
			0 0 45px rgba(96, 165, 250, 0.4);
		opacity: 0;
		animation: neonPulse 1.5s ease-in-out infinite;
		z-index: -1;
	}

	@keyframes neonPulse {
		0%,
		100% {
			opacity: 0.7;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
		}
	}

	.home-hero__social-icon {
		transition: all 0.3s ease;
	}

	/* Animación para móvil (desde abajo) */
	@keyframes slideInBottom {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Animación para escritorio (desde la derecha) */
	@keyframes slideInRight {
		0% {
			opacity: 0;
			transform: translateX(20px) translateY(-50%);
		}
		100% {
			opacity: 1;
			transform: translateX(0) translateY(-50%);
		}
	}

	.home-hero__socials {
		animation: slideInBottom 0.8s ease-out 0.8s both;
	}

	/* Ajustes para escritorio */
	@media (min-width: 1280px) {
		.home-hero__socials {
			top: 67%; /* Mantenemos la posición vertical específica */
			animation: slideInRight 0.8s ease-out 0.8s both;
		}
	}
</style>

<script>
	const triggerBtn = document.getElementById('share-trigger-btn');
	const menu = document.getElementById('share-menu-popover');
	const copyBtn = document.getElementById('copy-link-btn');

	// Setup Links
	const url = encodeURIComponent(window.location.href);
	const text = encodeURIComponent('¡Mira este portafolio increíble!');

	const whatsappLink = document.getElementById(
		'share-whatsapp',
	) as HTMLAnchorElement;
	const twitterLink = document.getElementById(
		'share-twitter',
	) as HTMLAnchorElement;
	const linkedinLink = document.getElementById(
		'share-linkedin',
	) as HTMLAnchorElement;

	if (whatsappLink)
		whatsappLink.href = `https://wa.me/?text=${text}%20${url}`;
	if (twitterLink)
		twitterLink.href = `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
	if (linkedinLink)
		linkedinLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;

	// Toggle Menu
	if (triggerBtn && menu) {
		triggerBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isHidden = menu.classList.contains('invisible');

			if (isHidden) {
				menu.classList.remove('invisible', 'opacity-0', 'scale-90');
				menu.classList.add('opacity-100', 'scale-100');
			} else {
				menu.classList.add('invisible', 'opacity-0', 'scale-90');
				menu.classList.remove('opacity-100', 'scale-100');
			}
		});

		// Close on click outside
		document.addEventListener('click', (e) => {
			if (
				!menu.classList.contains('invisible') &&
				!menu.contains(e.target as Node) &&
				!triggerBtn.contains(e.target as Node)
			) {
				menu.classList.add('invisible', 'opacity-0', 'scale-90');
				menu.classList.remove('opacity-100', 'scale-100');
			}
		});
	}

	// Copy functionality
	if (copyBtn) {
		copyBtn.addEventListener('click', async (e) => {
			e.preventDefault();
			await navigator.clipboard.writeText(window.location.href);

			const copyIcon = document.getElementById('copy-icon');
			const copyCheck = document.getElementById('copy-check');
			const copyText = document.getElementById('copy-text');

			if (copyIcon && copyCheck && copyText) {
				const copiedText = copyText.getAttribute('data-copied');
				const defaultText = copyText.getAttribute('data-default');

				copyIcon.classList.add('hidden');
				copyCheck.classList.remove('hidden');
				copyText.textContent = copiedText || 'Copied!';

				setTimeout(() => {
					copyIcon.classList.remove('hidden');
					copyCheck.classList.add('hidden');
					copyText.textContent = defaultText || 'Copy link';
				}, 2000);
			}
		});
	}
</script>
