---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;

const translations = {
	es: {
		copy_link: 'Copiar enlace',
		copied: '¡Copiado!',
		whatsapp: 'WhatsApp',
		twitter: 'Twitter',
		linkedin: 'LinkedIn',
	},
	en: {
		copy_link: 'Copy link',
		copied: 'Copied!',
		whatsapp: 'WhatsApp',
		twitter: 'Twitter',
		linkedin: 'LinkedIn',
	},
};

const t = translations[lang as keyof typeof translations] || translations.es;
