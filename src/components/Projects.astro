<script>
  // Import LightGallery and plugins directly within the client-side script
  import lightGallery from 'lightgallery/lightgallery.min.js';
  import lgZoom from 'lightgallery/plugins/zoom/lg-zoom.min.js';
  import lgThumbnail from 'lightgallery/plugins/thumbnail/lg-thumbnail.min.js';

  let section = document.getElementById('projects');
  let track = document.getElementById('projects-track');
  let isDesktop = window.matchMedia('(min-width: 1024px)').matches;

  function initScroll() {
    if (!section || !track) return;

    // Reset transforms if switching modes
    if (!isDesktop) {
      track.style.transform = 'none';
      return;
    }

    const handleScroll = () => {
      if (!isDesktop) return;

      const rect = section!.getBoundingClientRect();
      const viewportHeight = window.innerHeight;

      // Calculate how far we've scrolled into the section
      // The section is tall (300vh), so top goes negative
      const offsetTop = -rect.top;
      const totalScrollDistance = rect.height - viewportHeight;

      if (totalScrollDistance > 0) {
        let percentage = offsetTop / totalScrollDistance;
        // Clamp percentage between 0 and 1
        percentage = Math.max(0, Math.min(1, percentage));

        // Calculate max horizontal scroll
        const containerWidth = window.innerWidth;
        const trackWidth = track!.scrollWidth;
        const maxTranslate = trackWidth - containerWidth + containerWidth * 0.2; // Add some padding (20vw)

        const translateX = -(maxTranslate * percentage);

        requestAnimationFrame(() => {
          track!.style.transform = `translateX(${translateX}px)`;
        });
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Initial call
    handleScroll();
  }

  // Handle Resize
  window.addEventListener('resize', () => {
    const newIsDesktop = window.matchMedia('(min-width: 1024px)').matches;
    if (newIsDesktop !== isDesktop) {
      isDesktop = newIsDesktop;
      initScroll();
    }
  });

  // Initialize Scroll
  initScroll();

  let lgInstance = null;

  // Re-run Scroll initialization on View Transitions (if using Astro ViewTransitions)
  document.addEventListener('astro:page-load', () => {
    section = document.getElementById('projects');
    track = document.getElementById('projects-track');
    isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    initScroll();
    initLightGallery(); // <--- Inicializar lightGallery en cada carga de página
    initLightboxTriggers();
  });

  // LightGallery Initialization
  function initLightGallery() {
    const gallery = document.getElementById('case-study-gallery');

    if (lgInstance) {
      lgInstance.destroy();
      lgInstance = null;
    }

    if (gallery) {
      lgInstance = lightGallery(gallery, {
        plugins: [lgZoom, lgThumbnail], // Incluir plugins si se importaron
        licenseKey: '0000-0000-000-0000', // Reemplazar con tu licencia si es necesario
        selector: '.case-study-item', // lightGallery se inicializará en todos los <a> con esta clase dentro de la galería
        actualSize: false, // Desactiva el botón de tamaño real ya que es contenido HTML
        download: false, // Desactiva el botón de descarga
        // Puedes añadir más opciones según la documentación de lightGallery
      });
    }
  }

  function initLightboxTriggers() {
    const triggers = document.querySelectorAll('.js-trigger-lightbox');
    const articles = document.querySelectorAll('#case-study-gallery article');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const parentArticle = trigger.closest('article');
        if (parentArticle && lgInstance) {
          const articleIndex = Array.from(articles).indexOf(parentArticle);
          if (articleIndex !== -1) {
            lgInstance.openGallery(articleIndex);
          }
        }
      });
    });
  }

  // Initialize LightGallery and triggers on DOMContentLoaded for initial load
  document.addEventListener('DOMContentLoaded', () => {
    initLightGallery();
    initLightboxTriggers();

    // Card-level glow effect
    const cards = document.querySelectorAll('.card-glow');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const mouseEvent = e as MouseEvent;
        const htmlCard = card as HTMLElement;
        const rect = htmlCard.getBoundingClientRect();
        const x = ((mouseEvent.clientX - rect.left) / rect.width) * 100;
        const y = ((mouseEvent.clientY - rect.top) / rect.height) * 100;

        htmlCard.style.setProperty('--mouse-x', `${x}%`);
        htmlCard.style.setProperty('--mouse-y', `${y}%`);
      });
    });
  });
</script>

