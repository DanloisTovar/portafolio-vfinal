---
import { useTranslations } from '../i18n/utils';
import StarBorder from './Animations/StarBorder/StarBorder';
import imgWorkgroup from '../assets/imagen-workgroup.png';
import imgLati from '../assets/imagen-lati.png';
import imgPortfolio from '../assets/imagen-portafolio-web.png';

/* imagenes de caso de estudio */
import casoDeEstudioBueno1 from '../assets/caso_de_estudio/buen-codigo.png';
import casoDeEstudioBueno2 from '../assets/caso_de_estudio/buencodigo1.png';
import casoDeEstudioMalo1 from '../assets/caso_de_estudio/mal-codigo.png';
import casoDeEstudioMalo2 from '../assets/caso_de_estudio/malcodigo1.png';

/* imagenes de QA */
import qaDocumentacion from '../assets/qa_showcases/qa-documentacion.png';
import qaBug1 from '../assets/qa_showcases/GEF5-C7.gif';
import qaBug2 from '../assets/qa_showcases/GEF7-C5.gif';

interface Props {
  lang: 'es' | 'en';
}

interface Project {
  title: string;
  desc: string;
  tags: string[];
  image: string;
  url?: string;
  repo?: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects: Project[] = [
  /* Portafolio personal */
  {
    title: t('projects.portfolio.title'),
    desc: t('projects.portfolio.desc'),
    tags: ['Astro', 'React', 'TypeScript', 'Tailwind CSS', 'Motion', 'i18n', 'Zod', 'Vercel'],
    image: imgPortfolio.src,
    url: '',
    repo: '',
  },

  /* Workgroup */
  {
    title: t('projects.workgroup.title'),
    desc: t('projects.workgroup.desc'),
    tags: ['HTML', 'CSS', 'JavaScript', 'Bootstrap', 'PHP', 'Responsive', 'Accesibilidad', 'SEO'],
    image: imgWorkgroup.src,
    url: 'https://www.workgroup.com.ar/website.v3/',
    repo: '',
  },

  /* LATI */
  {
    title: t('projects.lati.title'),
    desc: t('projects.lati.desc'),
    tags: ['HTML', 'CSS', 'JavaScript', 'Bootstrap', 'PHP', 'Responsive', 'Accesibilidad', 'SEO'],
    image: imgLati.src,
    url: 'https://www.latisrl.com.ar/',
    repo: '',
  },
];
---

{/* contenedor principal de proyectos */}
<section id="projects" class="relative lg:h-[300vh] projects-pattern bg-white dark:bg-[#050b1b]">
  {/* Sticky Container for Desktop */}
  <div
    class="projects-sticky lg:sticky lg:top-0 lg:h-screen lg:overflow-hidden flex flex-col justify-center py-20 lg:py-0"
  >
    <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8 mb-8 lg:mb-12 relative z-10">
      <div class="text-center mb-16">
        <h2
          class="text-4xl tracking-tight sm:text-5xl mb-4 text-gray-900 dark:text-white font-orbitron font-medium"
        >
          <span class="bg-linear-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
            {t('projects.title')}
          </span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl mx-auto">
          {t('projects.subtitle')}
        </p>
        <div class="w-24 h-1 bg-linear-to-r from-blue-600 to-cyan-500 mx-auto mt-6 rounded-full">
        </div>
      </div>

      {/* Desktop Instructions (Absolute Right) */}
      <div class="hidden lg:flex flex-col items-end gap-1 opacity-60 absolute right-8 bottom-0">
        <span class="text-sm font-medium">SCROLL DOWN</span>
        <div class="w-px h-12 bg-current"></div>
      </div>

      {/* Mobile Instructions (Centered below title for mobile)*/}
      <div
        class="lg:hidden flex justify-center gap-2 text-sm font-medium text-gray-500 dark:text-gray-400 animate-pulse mt-6"
      >
        <span>← Swipe to explore →</span>
      </div>
    </div>

    {/* Scroll Track Container */}
    <div
      class="w-full overflow-x-auto lg:overflow-visible no-scrollbar px-4 md:px-8 lg:px-0 pb-8 lg:pb-0"
      id="projects-track-container"
    >
      {
        /* Mobile: Flex row with native scroll
        Desktop: Flex row that gets transformed via JS */
      }
      <div
        class="projects-track flex gap-6 md:gap-8 lg:gap-12 lg:px-[10vw] w-fit"
        id="projects-track"
      >
        {
          projects.map((project, index) => (
            <article class="relative flex-shrink-0 w-[85vw] sm:w-[400px] lg:w-[40vw] max-w-[800px] group rounded-[2rem] overflow-hidden bg-white dark:bg-gray-900 shadow-2xl lg:shadow-xl hover:shadow-blue-500/30 dark:hover:shadow-blue-500/40 transition-all duration-500 border border-gray-100 dark:border-gray-800">
              <StarBorder
                client:visible
                color="#3b82f6"
                speed={`${6 + Math.random() * 4}s`}
                delay={`-${Math.random() * 10}s`}
                className="transition-opacity duration-300 group-hover:opacity-0"
              />
              {/* imagen area*/}
              <div class="aspect-[4/3] lg:aspect-[16/10] overflow-hidden relative">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10 opacity-50 dark:opacity-60 lg:opacity-30 lg:dark:opacity-65 lg:group-hover:opacity-20 lg:dark:group-hover:opacity-60 transition-opacity duration-500" />
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover lg:scale-100 lg:group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                />

                {/*Floating Tags (Top Right)*/}
                <div class="absolute top-4 right-4 z-[60] flex flex-wrap justify-end gap-2 max-w-[80%]">
                  {project.tags.slice(0, 4).map((tag) => (
                    <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-white/90 dark:bg-black/80 backdrop-blur-md text-gray-900 dark:text-white shadow-lg">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              {/* Content Area - Now below image on mobile for better readability, overlay on desktop  ajustamos el overlay de las cards  con esto clases: lg:dark:opacity-100 y lg:dark:bg-transparent*/}
              <div class="p-6 md:p-8 relative z-20 bg-white dark:bg-gray-900 lg:absolute lg:inset-0 lg:bg-transparent lg:flex lg:flex-col lg:justify-end lg:bg-gradient-to-t lg:from-black/90 lg:via-black/50 lg:to-transparent lg:opacity-100 lg:dark:opacity-100 lg:dark:bg-transparent">
                <div class="lg:transform lg:translate-y-4 lg:group-hover:translate-y-0 lg:transition-transform lg:duration-1000 lg:ease-in-out">
                  {/* Mobile only tags (remaining) */}
                  <div class="flex lg:hidden flex-wrap gap-2 mb-3">
                    {project.tags.slice(2).map((tag) => (
                      <span class="px-2 py-1 text-[10px] uppercase font-bold text-gray-500 dark:text-gray-400 border border-gray-200 dark:border-gray-700 rounded-md">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white lg:text-white mb-3 lg:dark:drop-shadow-lg">
                    {project.title}
                  </h3>

                  <p class="text-gray-600 dark:text-gray-300 lg:text-gray-200 text-sm md:text-base leading-relaxed line-clamp-3 lg:line-clamp-2 lg:group-hover:line-clamp-none transition-all duration-500 lg:mb-0 lg:dark:drop-shadow-md">
                    {project.desc}
                  </p>

                  {/* Action Buttons */}
                  <div class="mt-4 lg:mt-6 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 lg:delay-100">
                    <div class="flex gap-3 flex-wrap">
                      {project.url ? (
                        <a
                          href={project.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 lg:text-white hover:underline"
                        >
                          {lang === 'es' ? 'Ver sitio' : 'View site'} <span class="text-lg">↗</span>
                        </a>
                      ) : (
                        <span class="inline-flex items-center gap-2 text-sm font-bold text-gray-400 dark:text-gray-500 cursor-not-allowed">
                          {lang === 'es' ? 'Sin enlace' : 'No link'}
                        </span>
                      )}
                      {project.repo ? (
                        <a
                          href={project.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 lg:text-white hover:underline"
                        >
                          {lang === 'es' ? 'Ver código' : 'View code'}{' '}
                          <span class="text-lg">↗</span>
                        </a>
                      ) : (
                        <span class="inline-flex items-center gap-2 text-sm font-bold text-gray-400 dark:text-gray-500 cursor-not-allowed">
                          {lang === 'es' ? 'Repositorio privado' : 'Private repo'}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
{/* Caso de de estudio */}
<section id="case-study" class="py-20 lg:py-32 bg-white dark:bg-[#050b1b] projects-pattern">
  <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8">
    <div class="text-center mb-16">
      <h2
        class="text-4xl tracking-tight sm:text-5xl mb-4 text-gray-900 dark:text-white font-orbitron font-medium"
      >
        <span class="bg-linear-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
          {t('projects.caseStudy.title')}
        </span>
      </h2>
      <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl mx-auto">
        {t('projects.caseStudy.subtitle')}
      </p>
      <div class="w-24 h-1 bg-linear-to-r from-blue-600 to-cyan-500 mx-auto mt-6 rounded-full">
      </div>
    </div>

    <div id="case-study-gallery" class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-12">
      <article
        class="relative flex-shrink-0 w-full group rounded-[2rem] h-[28rem] md:h-[36rem] lg:h-[40rem] overflow-hidden bg-white dark:bg-gray-900 shadow-2xl lg:shadow-xl hover:shadow-blue-500/30 dark:hover:shadow-blue-500/40 transition-all duration-500 border border-gray-100 dark:border-gray-800"
      >
        <StarBorder
          client:visible
          color="#3b82f6"
          speed={`${6 + Math.random() * 4}s`}
          delay={`-${Math.random() * 10}s`}
          className="transition-opacity duration-300 group-hover:opacity-0"
        />
        {/* imagen area*/}
        <a
          href={casoDeEstudioMalo2.src}
          class="block lg:[display:unset] aspect-[5/3] lg:aspect-[16/10] overflow-hidden relative cursor-pointer case-study-item"
          data-sub-html={`<h4>${t('projects.caseStudy.image1.title')}</h4><p>${t('projects.caseStudy.image1.desc')}</p>`}
        >
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10 opacity-50 dark:opacity-60 lg:opacity-30 lg:dark:opacity-65 lg:group-hover:opacity-20 lg:dark:group-hover:opacity-60 transition-opacity duration-500"
          >
          </div>
          <img
            src={casoDeEstudioMalo1.src}
            alt={t('projects.caseStudy.image1.title')}
            class="w-full h-full object-cover lg:scale-100 lg:group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
          />
        </a>

        {
          /* Content Area - Now below image on mobile for better readability, overlay on desktop  ajustamos el overlay de las cards  con esto clases: lg:dark:opacity-100 y lg:dark:bg-transparent*/
        }
        <div
          class="p-6 md:p-8 relative z-20 bg-white dark:bg-gray-900 lg:absolute lg:inset-0 lg:bg-transparent lg:flex lg:flex-col lg:justify-end lg:bg-gradient-to-t lg:from-black/90 lg:via-black/50 lg:to-transparent lg:opacity-100 lg:dark:opacity-100 lg:dark:bg-transparent"
        >
          <div
            class="lg:transform lg:translate-y-4 lg:group-hover:translate-y-0 lg:transition-transform lg:duration-1000 lg:ease-in-out"
          >
            <h3
              class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white lg:text-white mb-3 lg:dark:drop-shadow-lg"
            >
              {t('projects.caseStudy.image1.title')}
            </h3>

            <p
              class="text-gray-600 dark:text-gray-300 lg:text-gray-200 text-sm md:text-base leading-relaxed line-clamp-3 lg:line-clamp-2 lg:group-hover:line-clamp-none transition-all duration-500 lg:mb-0 lg:dark:drop-shadow-md"
            >
              {t('projects.caseStudy.image1.desc')}
            </p>

            {/* Action Buttons */}

            <div
              class="mt-4 lg:mt-6 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 lg:delay-100"
            >
              <div class="flex gap-3 flex-wrap">
                <a
                  href={casoDeEstudioMalo2.src}
                  class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 lg:text-white hover:underline js-trigger-lightbox"
                  data-sub-html={`<h4>${t('projects.caseStudy.image1.title')}</h4><p>${t('projects.caseStudy.image1.desc')}</p>`}
                >
                  {t('projects.caseStudy.button.view')}
                </a>
              </div>
            </div>
          </div>
        </div>
      </article>
      <article
        class="relative flex-shrink-0 w-full group rounded-[2rem] h-[28rem] md:h-[36rem] lg:h-[40rem] overflow-hidden bg-white dark:bg-gray-900 shadow-2xl lg:shadow-xl hover:shadow-blue-500/30 dark:hover:shadow-blue-500/40 transition-all duration-500 border border-gray-100 dark:border-gray-800"
      >
        <StarBorder
          client:visible
          color="#3b82f6"
          speed={`${6 + Math.random() * 4}s`}
          delay={`-${Math.random() * 10}s`}
          className="transition-opacity duration-300 group-hover:opacity-0"
        />
        {/* imagen area*/}
        <a
          href={casoDeEstudioBueno2.src}
          class="block lg:[display:unset] aspect-[5/3] lg:aspect-[16/10] overflow-hidden relative cursor-pointer case-study-item"
          data-sub-html={`<h4>${t('projects.caseStudy.image2.title')}</h4><p>${t('projects.caseStudy.image2.desc')}</p>`}
        >
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-10 opacity-50 dark:opacity-60 lg:opacity-30 lg:dark:opacity-65 lg:group-hover:opacity-20 lg:dark:group-hover:opacity-60 transition-opacity duration-500"
          >
          </div>
          <img
            src={casoDeEstudioBueno1.src}
            alt={t('projects.caseStudy.image2.title')}
            class="w-full h-full object-cover lg:scale-100 lg:group-hover:scale-105 transition-transform duration-700 ease-out"
            loading="lazy"
          />
        </a>

        {
          /* Content Area - Now below image on mobile for better readability, overlay on desktop  ajustamos el overlay de las cards  con esto clases: lg:dark:opacity-100 y lg:dark:bg-transparent*/
        }
        <div
          class="p-6 md:p-8 relative z-20 bg-white dark:bg-gray-900 lg:absolute lg:inset-0 lg:bg-transparent lg:flex lg:flex-col lg:justify-end lg:bg-gradient-to-t lg:from-black/90 lg:via-black/50 lg:to-transparent lg:opacity-100 lg:dark:opacity-100 lg:dark:bg-transparent"
        >
          <div
            class="lg:transform lg:translate-y-4 lg:group-hover:translate-y-0 lg:transition-transform lg:duration-1000 lg:ease-in-out"
          >
            <h3
              class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white lg:text-white mb-3 lg:dark:drop-shadow-lg"
            >
              {t('projects.caseStudy.image2.title')}
            </h3>

            <p
              class="text-gray-600 dark:text-gray-300 lg:text-gray-200 text-sm md:text-base leading-relaxed line-clamp-3 lg:line-clamp-2 lg:group-hover:line-clamp-none transition-all duration-500 lg:mb-0 lg:dark:drop-shadow-md"
            >
              {t('projects.caseStudy.image2.desc')}
            </p>

            {/* Action Buttons */}

            <div
              class="mt-4 lg:mt-6 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 lg:delay-100"
            >
              <div class="flex gap-3 flex-wrap">
                <a
                  href={casoDeEstudioBueno2.src}
                  class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 lg:text-white hover:underline js-trigger-lightbox"
                  data-sub-html={`<h4>${t('projects.caseStudy.image2.title')}</h4><p>${t('projects.caseStudy.image2.desc')}</p>`}
                >
                  {t('projects.caseStudy.button.view')}
                </a>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <div class="w-full max-w-[1400px] mx-auto px-0 md:px-8 mt-12">
      <div class="grid grid-cols-1 gap-6">
        <div
          class="group relative overflow-hidden rounded-3xl bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 p-8 hover:shadow-2xl hover:shadow-blue-500/10 dark:hover:shadow-blue-500/20 transition-all duration-500 hover:-translate-y-1 card-glow"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div
            class="cursor-glow pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div class="relative z-10 text-center">
            <div
              class="w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-500 mx-auto"
            >
              <svg
                class="w-6 h-6 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <p
              class="text-gray-600 dark:text-gray-300 text-lg md:text-xl leading-relaxed whitespace-pre-line"
            >
              {t('projects.caseStudy.description')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ------------------------------------QA analyst ---------------------------------- */}

<section id="qa-showcase" class="py-20 lg:py-32 bg-white dark:bg-[#050b1b] projects-pattern">
  <!-- Background gradient effects -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-blue-50/50 via-transparent to-blue-50/50 dark:from-blue-950/20 dark:via-transparent dark:to-blue-950/20"
  >
  </div>
  <!-- Cursor glow effect for entire section -->
  <div
    class="section-cursor-glow pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-300"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">
    <!-- Section Title with gradient -->
    <div class="text-center mb-16">
      <h2
        class="text-4xl tracking-tight sm:text-5xl mb-4 text-gray-900 dark:text-white font-orbitron font-medium"
      >
        <span class="bg-linear-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
          {t('qa.showcase.title')}
        </span>
      </h2>
      <p class="text-gray-600 dark:text-gray-400 text-lg max-w-2xl mx-auto">
        {t('qa.showcase.subtitle')}
      </p>
      <div class="w-24 h-1 bg-linear-to-r from-blue-600 to-cyan-500 mx-auto mt-6 rounded-full">
      </div>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8 mb-12">
      <!-- Main documentation card - spans 2 columns on large screens -->
      <div
        class="lg:col-span-2 group relative overflow-hidden rounded-3xl bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 p-8 hover:shadow-2xl hover:shadow-blue-500/10 dark:hover:shadow-blue-500/20 transition-all duration-500 hover:-translate-y-1 card-glow"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-blue-500/5 dark:from-blue-500/10 dark:to-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
        <div
          class="cursor-glow pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-500"
        >
        </div>
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center"
            >
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
              {t('qa.showcase.documentation')}
            </h3>
          </div>
          <p class="text-lg font-medium text-gray-900 dark:text-white mb-4">
            {t('qa.showcase.testplan_title')}
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
            {t('qa.showcase.testplan_desc')}
          </p>
          <div
            class="aspect-[16/9] bg-gray-100 dark:bg-gray-800 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-500"
          >
            <!-- <p class="text-gray-500 dark:text-gray-400 text-center text-lg">
              {t('qa.showcase.placeholder_image')}
            </p> -->

            <img
              src={qaDocumentacion.src}
              alt="QA Documentation"
              class="w-full h-full rounded-2xl"
            />
          </div>
        </div>
      </div>

      <!-- Bugs section with animated elements -->
      <div class="space-y-6">
        <!-- Bug 1 -->
        <div
          class="group relative overflow-hidden rounded-3xl bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border border-gray-200/50 dark:border-gray-700/50 p-6 hover:shadow-xl hover:shadow-blue-500/10 dark:hover:shadow-blue-500/20 transition-all duration-500 hover:-translate-y-1 card-glow"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div class="relative z-10">
            <div class="flex items-center gap-3 mb-4">
              <div
