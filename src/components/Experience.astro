---
import { useTranslations } from '../i18n/utils';
import { Briefcase, Building2 } from 'lucide-react';
import GlareHover from './Animations/GlareHover/GlareHover';
import SectionHeader from './ui/SectionHeader.astro';
import GlassCard from './ui/GlassCard.astro';
import IconBox from './ui/IconBox.astro';
import TechBadge from './ui/TechBadge.astro';

interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const calendarSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>';

const experiences = [
	{
		id: 'job1',
		role: t('experience.job1.role'),
		company: t('experience.job1.company'),
		duration: t('experience.job1.duration'),
		desc: t('experience.job1.desc'),
	},
	{
		id: 'job2',
		role: t('experience.job2.role'),
		company: t('experience.job2.company'),
		duration: t('experience.job2.duration'),
		desc: t('experience.job2.desc'),
	},
	{
		id: 'job3',
		role: t('experience.job3.role'),
		company: t('experience.job3.company'),
		duration: t('experience.job3.duration'),
		desc: t('experience.job3.desc'),
	},
	{
		id: 'job4',
		role: t('experience.job4.role'),
		company: t('experience.job4.company'),
		duration: t('experience.job4.duration'),
		desc: t('experience.job4.desc'),
	},
];
---

<section id="experiencia" class="section-glow py-24 px-4 bg-white dark:bg-gray-950 relative overflow-hidden">
	<!-- Light Sky Blue Glow overlay (only light mode) -->
	<div
		class="absolute inset-0 -z-20 pointer-events-none dark:hidden"
		style="background-image: radial-gradient(circle at center, #93c5fd, transparent);"
	></div>
	<!-- Steel Blue radial glow (only dark mode) -->
	<div
		class="absolute inset-0 -z-20 pointer-events-none hidden dark:block"
		style="background-image: radial-gradient(circle at 50% 50%, rgb(59 130 246 / 16%) 0%, rgb(59 130 246 / 9%) 25%, rgb(59 130 246 / 4%) 35%, transparent 50%); background-size: 100% 100%;"
	></div>
	<!-- Decorative Background -->
	<div class="absolute inset-0 opacity-20 pointer-events-none overflow-hidden">
		<div id="parallax-bg-1" class="absolute top-1/4 right-0 w-125 h-125 bg-blue-600/10 rounded-full blur-[120px] translate-x-1/2"></div>
		<div id="parallax-bg-2" class="absolute bottom-1/4 left-0 w-125 h-125 bg-cyan-600/10 rounded-full blur-[120px] -translate-x-1/2"></div>
	</div>

	<!-- Cursor glow effect -->

	<div class="max-w-6xl mx-auto relative z-10">
		<SectionHeader
			variant="gradient-cyan"
			title={t('experience.title')}
			subtitle={t('experience.subtitle')}
			marginBottom="mb-20"
		/>

		<div class="relative">
			<!-- Vertical Line Area -->
			<div class="absolute left-6 lg:left-1/2 top-4 bottom-4 w-1 bg-gray-200 dark:bg-gray-800 lg:-translate-x-1/2 rounded-full overflow-hidden">
				<!-- Animated Progress Line -->
				<div id="experience-progress-line" class="absolute top-0 left-0 w-full h-0 bg-linear-to-b from-blue-600 via-cyan-500 to-transparent shadow-[0_0_15px_rgba(37,99,235,0.5)] transition-all duration-300"></div>
			</div>

			<div class="space-y-24">
				{experiences.map((exp, index) => (
					<div class={`experience-item relative flex flex-col lg:flex-row items-center group ${index % 2 === 0 ? 'lg:flex-row-reverse' : ''}`}>
						<!-- Node -->
						<div class="experience-node absolute left-6 lg:left-1/2 w-8 h-8 bg-white dark:bg-gray-950 border-4 border-gray-200 dark:border-gray-800 rounded-full z-20 transform -translate-x-1/2 transition-all duration-500 shadow-xl group-hover:border-blue-600 group-hover:shadow-[0_0_20px_rgba(37,99,235,0.4)] group-[.active]:border-blue-600 group-[.active]:shadow-[0_0_20px_rgba(37,99,235,0.4)]">
							<div class="absolute inset-2 bg-blue-600 rounded-full opacity-0 group-hover:opacity-100 group-hover:scale-100 group-[.active]:opacity-100 group-[.active]:scale-100 transition-all duration-500"></div>
						</div>

						<!-- Content Card Container for Parallax -->
						<div class="experience-card-container w-full lg:w-[45%] pl-12 lg:pl-0 overflow-visible">
							<GlareHover client:visible borderRadius="24px" glareColor="var(--experience-glare)">
								<div class="p-0.5 rounded-3xl bg-linear-to-br from-blue-500/20 to-transparent hover:from-blue-500/40 transition-all duration-500 hover:-translate-y-1">
									<GlassCard variant="experience" class="!rounded-[calc(1.5rem-2px)]">
										<div class="flex items-center gap-4 mb-4">
											<IconBox size="exp" color="light" class="!bg-blue-600/10 !text-blue-600 dark:!text-blue-400">
												<Briefcase size={24} />
											</IconBox>
											<div>
												<h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
													{exp.role}
												</h3>
												<div class="flex items-center gap-2 text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
													<Building2 size={14} />
													<span class="font-semibold">{exp.company}</span>
												</div>
											</div>
										</div>

										<TechBadge variant="duration" label={exp.duration} icon={calendarSvg} class="mb-4" />

										<div class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm text-justify" set:html={exp.desc} />

										<div class="mt-6 flex flex-wrap gap-2">
											<div class="h-1 w-12 bg-linear-to-r from-blue-600 to-transparent rounded-full"></div>
										</div>
									</GlassCard>
								</div>
							</GlareHover>
						</div>

						<!-- Spacer for desktop -->
						<div class="hidden lg:block lg:w-[10%]"></div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	#experiencia {
		--experience-glare: rgb(37 99 235 / 30%);
	}

	:global(.dark) #experiencia {
		--experience-glare: rgb(255 255 255 / 30%);
	}

	.experience-progress-line {
		will-change: height;
	}
</style>

<script>
	import { scroll, animate, inView } from "motion";


	
	const section = document.getElementById("experiencia");
	const bg1 = document.getElementById("parallax-bg-1");
	const bg2 = document.getElementById("parallax-bg-2");
	const progressLine = document.getElementById("experience-progress-line");

	if (section) {
		// 1. Background Parallax
		if (bg1) {
			scroll(animate(bg1, { y: [-150, 150] }), {
				target: section,
				offset: ["start end", "end start"]
			});
		}

		if (bg2) {
			scroll(animate(bg2, { y: [150, -150] }), {
				target: section,
				offset: ["start end", "end start"]
			});
		}

		// 2. Timeline Progress Line
		if (progressLine) {
			scroll((progress: number) => {
				progressLine.style.height = `${progress * 100}%`;
			}, {
				target: section,
				offset: ["start center", "end center"]
			});
		}
	}

	// 3. Card Parallax (Subtle vertical offset for cards based on scroll)
	const cards = document.querySelectorAll(".experience-card-container");
	cards.forEach((card) => {
		if (card instanceof HTMLElement) {
			scroll(animate(card, { y: [30, -30] }), {
				target: card,
				offset: ["start end", "end start"]
			});
		}
	});

	// 4. Mobile Node Activation on Scroll (InView)
	const experienceItems = document.querySelectorAll(".experience-item");
	experienceItems.forEach((item) => {
		inView(item, () => {
			item.classList.add("active");
			return () => item.classList.remove("active");
		}, { margin: "-40% 0px -40% 0px" });
	});
</script>
