---
import { useTranslations } from '../i18n/utils';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import GlassCard from './ui/GlassCard.astro';
import IconBox from './ui/IconBox.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="sobre-mi">
  <!-- Section Title with gradient -->
  <SectionHeader
    variant="gradient-accent"
    title={lang === 'es' ? 'Sobre Mí' : 'About Me'}
    accentText={lang === 'es' ? 'Mí' : 'Me'}
    subtitle={t('about.intro')}
  />

  <!-- Bento Grid Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
    <!-- Main intro card - spans 2 columns on large screens -->
    <div class="lg:col-span-2">
      <GlassCard variant="glass-card-full">
        <div class="flex items-center gap-3 mb-6">
          <IconBox size="lg" color="gradient">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </IconBox>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
            {lang === 'es' ? 'Sobre Mí' : 'About Me'}
          </h3>
        </div>
        <p class="text-lg font-medium text-gray-900 dark:text-white mb-4">
          {t('about.intro')}
        </p>
        <p class="text-gray-600 dark:text-gray-300 mb-4 leading-relaxed text-justify">
          {t('about.description')}
        </p>
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-justify">
          {t('about.experience')}
        </p>
      </GlassCard>
    </div>

    <!-- Stats card with animated counter effect -->
    <div class="space-y-6">
      <!-- Robot Animation -->
      <div class="h-full w-full min-h-[400px] relative overflow-hidden leading-[0]">
        <spline-viewer url="https://prod.spline.design/wYmVAwFQIL3qrH3r/scene.splinecode"
        ></spline-viewer>
      </div>

      <!-- Experience stat (Commented Out)
      <div ...>
      </div>
      -->

      <!-- Projects stat (Commented Out)
      <div ...>
      </div>
      -->
    </div>
  </div>

  <!-- Skills/Interests cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Skill card 1 -->
    <GlassCard variant="glass-card-full" padding="p-6" gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent" class="hover:!shadow-xl">
      <IconBox size="lg" color="light" class="mb-4">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
      </IconBox>
      <h4 class="font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'es' ? 'Desarrollo Web' : 'Web Development'}
      </h4>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        {lang === 'es' ? 'Interfaces modernas y responsive' : 'Modern and responsive interfaces'}
      </p>
    </GlassCard>

    <!-- Skill card 2 -->
    <GlassCard variant="glass-card-full" padding="p-6" gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent" class="hover:!shadow-xl">
      <IconBox size="lg" color="light" class="mb-4">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
        </svg>
      </IconBox>
      <h4 class="font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'es' ? 'Diseño UI/UX' : 'UI/UX Design'}
      </h4>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        {lang === 'es' ? 'Experiencias centradas en el usuario' : 'User-centered experiences'}
      </p>
    </GlassCard>

    <!-- Skill card 3 -->
    <GlassCard variant="glass-card-full" padding="p-6" gradientOverlay="from-blue-500/5 to-transparent dark:from-blue-500/10 to-transparent" class="hover:!shadow-xl">
      <IconBox size="lg" color="light" class="mb-4">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </IconBox>
      <h4 class="font-semibold text-gray-900 dark:text-white mb-2">
        {lang === 'es' ? 'Optimización' : 'Performance'}
      </h4>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        {lang === 'es' ? 'Código rápido y eficiente' : 'Fast and efficient code'}
      </p>
    </GlassCard>
  </div>
</Section>

<style is:global>
  /* Spline viewer logo hiding */
  spline-viewer {
    display: block;
  }
</style>

<script>
  import { initCardGlow } from '../lib/cursorGlow';

  initCardGlow();

  function hideSplineLogo() {
    const viewers = document.querySelectorAll('spline-viewer');
    viewers.forEach((viewer) => {
      const v = viewer as any;
      const tryHide = () => {
        const logo = v?.shadowRoot?.getElementById('logo') as HTMLElement | null;
        if (logo) {
          logo.style.setProperty('display', 'none', 'important');
          logo.style.setProperty('visibility', 'hidden', 'important');
          logo.style.setProperty('opacity', '0', 'important');
          return true;
        }
        return false;
      };

      if (!tryHide()) {
        const root = v.shadowRoot || v;
        const obs = new MutationObserver(() => {
          if (tryHide()) obs.disconnect();
        });
        obs.observe(root, { childList: true, subtree: true });
      }
    });
  }

  // Initialize cursor glow effects

  // Hide Spline logo (with retries for deferred loading)
  document.addEventListener('DOMContentLoaded', () => {
    hideSplineLogo();
    setTimeout(hideSplineLogo, 300);
    setTimeout(hideSplineLogo, 1000);
  });
</script>
