---
import GlassCard from './GlassCard.astro';

interface Props {
  target: string;
  initial: string;
  label: string;
  decimals?: string;
  suffix?: string;
  class?: string;
}

const { target, initial, label, decimals, suffix, class: className } = Astro.props;
---

<GlassCard variant="glass-card-full" padding="p-6" class={className}>
  <div class="relative flex flex-col items-center text-center">
    <div
      class="absolute -top-2 left-1/2 -translate-x-1/2 w-24 h-24 rounded-full bg-blue-500/20 blur-2xl pointer-events-none"
      aria-hidden="true"
    />
    <span
      class="relative text-4xl sm:text-5xl lg:text-6xl font-black text-blue-600 dark:text-blue-400"
      data-counter
      data-target={target}
      data-decimals={decimals ?? '0'}
      data-suffix={suffix ?? ''}
    >
      {initial}
    </span>
    <span class="mt-3 text-[11px] sm:text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
      {label}
    </span>
  </div>
</GlassCard>
