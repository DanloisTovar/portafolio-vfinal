---
import GlassCard from './GlassCard.astro';
import IconBox from './IconBox.astro';

interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<GlassCard variant="glass-card-full" class={className ? `h-full ${className}` : 'h-full'}>
  <div class="flex flex-col gap-4 h-full">
    <div class="flex items-center gap-4">
      <IconBox size="lg" color="gradient">
        <slot />
      </IconBox>
      <h3 class="text-xl font-bold text-gray-900 dark:text-white">{title}</h3>
    </div>
    <p class="text-gray-600 dark:text-gray-300 leading-relaxed text-justify">{description}</p>
    <slot name="extra" />
  </div>
</GlassCard>
