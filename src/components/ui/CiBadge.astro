---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class={`inline-flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-4 py-1.5 text-xs sm:text-sm font-medium text-green-700 dark:text-green-400${className ? ` ${className}` : ''}`}
  role="status"
  aria-label="CI status: passing"
>
  <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
    <span
      class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
    ></span>
    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
  </span>
  {label}
</span>
