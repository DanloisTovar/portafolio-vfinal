---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`relative h-12 overflow-hidden${className ? ` ${className}` : ''}`}>
  <div
    class="absolute inset-0 bg-linear-to-r from-blue-600/10 via-blue-500/15 to-cyan-500/10 dark:from-blue-400/5 dark:via-blue-400/10 dark:to-cyan-400/5"
    style="clip-path: polygon(0 0, 100% 40%, 100% 100%, 0 60%);"
  >
  </div>
</div>
