---
interface Props {
  size: 'lg' | 'md' | 'sm' | 'xl' | 'xl-dynamic' | 'exp' | 'footer';
  color: 'gradient' | 'light' | 'dark';
  class?: string;
  centered?: boolean;
}

const { size, color, class: className, centered } = Astro.props;

const sizes: Record<string, string> = {
  lg: 'w-12 h-12 rounded-2xl',
  md: 'w-10 h-10 rounded-2xl',
  sm: 'w-8 h-8 rounded-xl',
  xl: 'w-14 h-14 rounded-2xl',
  'xl-dynamic': 'w-14 h-14 rounded-2xl',
  exp: 'p-3 rounded-2xl',
  footer: 'w-12 h-12 rounded-2xl',
};

const colors: Record<string, string> = {
  gradient: 'bg-gradient-to-br from-blue-500 to-blue-600 text-white shadow-lg',
  light: 'bg-blue-100 dark:bg-blue-900/30',
  dark: 'bg-gray-100 dark:bg-gray-800',
};

const sizeClasses = sizes[size];
const colorClasses = colors[color];
const centerClass = centered ? ' mx-auto' : '';
---

<div
  class={`flex items-center justify-center ${sizeClasses} ${colorClasses} flex-shrink-0${centerClass}${className ? ` ${className}` : ''}`}
>
  <slot />
</div>
