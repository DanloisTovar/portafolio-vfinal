---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import CaseStudy from '../../components/sections/CaseStudy.astro';
import QAShowcase from '../../components/sections/QAShowcase.astro';
// import WordPressProjects from '../../components/sections/WordPressProjects.astro';
import News from '../../components/News.astro';
import Contact from '../../components/Contact.astro';
import Skills from '../../components/Skills.astro';
import Footer from '../../components/Footer.astro';
import { languages } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
---

<Layout
  title={lang === 'es'
    ? 'Portfolio | Danlois Tovar - Desarrollador Front End'
    : 'Portfolio | Danlois Tovar - Front End Developer'}
  description={lang === 'es'
    ? 'Desarrollador Front End especializado en React, Astro, TypeScript y Tailwind CSS. Creando aplicaciones web modernas, optimizadas y escalables.'
    : 'Front End Developer specialized in React, Astro, TypeScript and Tailwind CSS. Building modern, optimized and scalable web applications.'}
>
  <main>
    <Hero lang={lang as 'es' | 'en'} />
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <About lang={lang as 'es' | 'en'} />
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <Skills lang={lang as 'es' | 'en'} />
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <Experience lang={lang as 'es' | 'en'} />
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <div class="projects-pattern bg-white dark:bg-[#050b1b]">
      <Projects lang={lang as 'es' | 'en'} />
      <hr
        class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
      />
      <CaseStudy lang={lang as 'es' | 'en'} />
      <hr
        class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
      />
      {/* <WordPressProjects lang={lang as 'es' | 'en'} /> */}
      <hr
        class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
      />
      <QAShowcase lang={lang as 'es' | 'en'} />
    </div>
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <Contact lang={lang as 'es' | 'en'} />
    <hr
      class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
    />
    <News lang={lang as 'es' | 'en'} />
  </main>

  <hr
    class="w-full h-px border-0 bg-linear-to-r from-blue-600 to-cyan-500 opacity-40 my-0 rounded-full"
  />
  <Footer lang={lang as 'es' | 'en'} />
</Layout>
