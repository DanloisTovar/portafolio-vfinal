---
import Navbar from '../components/Navbar';
import SocialMenu from '../components/SocialMenu.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Desarrollador Front End especializado en crear aplicaciones web modernas, optimizadas y escalables con React, Astro y TypeScript.',
  image = '/images/og-image.jpg',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://danloisdev.com');
const ogImageURL = new URL(image, Astro.site || 'https://danloisdev.com');

const navItems = [
  { label: t('nav.home'), href: `/${lang}#home`, icon: 'home' },
  { label: t('nav.about'), href: `/${lang}#sobre-mi`, icon: 'about' },
  { label: t('nav.skills'), href: `/${lang}#skills`, icon: 'skills' },
  {
    label: t('nav.experience'),
    href: `/${lang}#experiencia`,
    icon: 'experience',
  },
  { label: t('nav.projects'), href: `/${lang}#projects`, icon: 'projects' },
  { label: t('nav.news'), href: `/${lang}#news`, icon: 'news' },
  { label: t('nav.contact'), href: `/${lang}#contact`, icon: 'contact' },
] as const;
---

<!doctype html>
<html lang={lang} class="scroll-smooth relative">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Danlois Tovar" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#3b82f6" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:site_name" content="Danlois Tovar - Portfolio" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
    <meta property="twitter:creator" content="@DanloisDev" />

    <!-- Prefetch recursos críticos -->
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="dns-prefetch" href="https://prod.spline.design" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Schema.org JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Danlois Tovar',
        jobTitle: lang === 'es' ? 'Desarrollador Front End' : 'Front End Developer',
        url: Astro.site || 'https://danloisdev.com',
        description: description,
        sameAs: [
          'https://github.com/DanloisTovar',
          'https://linkedin.com/in/danlois-tovar',
          'https://twitter.com/DanloisDev',
        ],
        knowsAbout: [
          'React',
          'Astro',
          'TypeScript',
          'Tailwind CSS',
          'JavaScript',
          'Frontend Development',
        ],
        worksFor: {
          '@type': 'Organization',
          name: 'Workgroup S.L.',
        },
      })}
    />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script is:inline>
      // Cargar Spline Viewer solo si no está ya registrado
      if (!customElements.get('spline-viewer')) {
        const script = document.createElement('script');
        script.type = 'module';
        script.src = 'https://unpkg.com/@splinetool/viewer@1.12.50/build/spline-viewer.js';
        document.head.appendChild(script);
      }
    </script>
  </head>
  <body
    class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 transition-colors duration-300 relative"
  >
    <Navbar client:load items={navItems} currentLang={lang} />
    <SocialMenu lang={lang} />
    <slot />
  </body>
</html>
